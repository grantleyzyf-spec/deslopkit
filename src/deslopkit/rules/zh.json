{
  "version": "0.1.0",
  "lang": "zh",
  "note": "中文规则库。severity: high=典型机器痕迹；action: rewrite=有确定性改写模板，review=仅提示需人工判断。skip_quoted=true 表示命中落在“引号”或《书名号》内时跳过（保护引文原样）。",
  "rules": [
    {
      "id": "zh.neg.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "(?:并非|不是|不在于)([^，。；：！？]{2,40})，(?:而是|而在于)([^。；！？]{4,80})",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\2，而不是\\1",
      "message": "翻案腔：先立一个不存在的误解再推翻（“不是A，而是B”）。",
      "fix_hint": "改成正面陈述，把对比降为句末补充（“……，而不是……”），或直接删掉否定分句。"
    },
    {
      "id": "zh.neg.002",
      "lang": "zh",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "(?:不在于)([^，。；：]{2,40})，(?:而在于)([^。；]{2,80})",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\2，而不在于\\1",
      "message": "翻案腔变体（“不在于A，而在于B”）。",
      "fix_hint": "正面陈述 B，把 A 降为句末限定。"
    },
    {
      "id": "zh.neg.003",
      "lang": "zh",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "与其说([^，。；]{2,40})，不如说([^。；]{2,60})",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\2",
      "message": "翻案腔变体（“与其说A，不如说B”）。",
      "fix_hint": "直接说 B。"
    },
    {
      "id": "zh.neg.004",
      "lang": "zh",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "(?:看似|表面上|看起来)([^，。；]{2,40})，(?:实则|实际上|其实)([^。；]{2,60})",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\2",
      "message": "翻案腔变体（“看似A，实则B”）。",
      "fix_hint": "直接陈述实际情形，必要时再补一句说明偏差来源。"
    },
    {
      "id": "zh.neg.005",
      "lang": "zh",
      "registers": ["all"],
      "category": "filler",
      "pattern": "(?:说到底|归根结底|答案恰恰相反|真正的问题在于|更深一层)",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "抬价式路标：给下文制造“更深一层”的假深度。",
      "fix_hint": "删掉路标，直接写事实或判断。"
    },
    {
      "id": "zh.fil.005",
      "lang": "zh",
      "registers": ["all"],
      "category": "filler",
      "pattern": "(?:值得注意的是|需要指出的是|不难看出|不难发现|显而易见|众所周知|毋庸置疑)[：，,:]?",
      "severity": "high",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "伪洞察路标：不带来任何信息，纯占位。",
      "fix_hint": "删除后把真正想说的那句直接写出来。"
    },
    {
      "id": "zh.sig.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "signposting",
      "pattern": "其[一二三四五六七八九]是",
      "severity": "medium",
      "action": "review",
      "strategy": "signpost",
      "message": "分点路标“其一是…其二是…”。",
      "fix_hint": "改为实词领起（如“在要素层面…”“从过程看…”），或把分点并入陈述句。"
    },
    {
      "id": "zh.sig.002",
      "lang": "zh",
      "registers": ["all"],
      "category": "signposting",
      "pattern": "(?:^|[。；])(?:首先|其次|再次|最后|第一|第二|第三|第四)[，、,]?",
      "severity": "medium",
      "action": "review",
      "strategy": "signpost",
      "message": "序数路标链：“首先/其次/最后”。",
      "fix_hint": "保留分点但换成有信息的领起词；若只是并列，直接合并成一句。"
    },
    {
      "id": "zh.sig.003",
      "lang": "zh",
      "registers": ["zh-forum"],
      "category": "signposting",
      "pattern": "(?:综上所述|由此可见|总而言之|总的来说)",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "总结式路标。",
      "fix_hint": "删掉后直接给判断；确需收束时用“从数据上看…”这类带信息的过渡。"
    },
    {
      "id": "zh.jar.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "赋能",
      "severity": "high",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "助力",
      "message": "“赋能”是典型的 AI 时代公文黑话。",
      "fix_hint": "换成具体动词（助力/支撑/推动），并补出具体动作或作用点。"
    },
    {
      "id": "zh.jar.002",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "抓手",
      "severity": "high",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "着力点",
      "message": "“抓手”是汇报体黑话。",
      "fix_hint": "换成“着力点/切入点/关键环节”，或直接写具体做法。"
    },
    {
      "id": "zh.jar.003",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "迭代闭环|形成闭环|闭环管理|教研闭环",
      "severity": "high",
      "action": "review",
      "strategy": "jargon",
      "message": "“闭环”类黑话。",
      "fix_hint": "换成具体机制描述：如“每轮试点后修订一次，共三轮”。"
    },
    {
      "id": "zh.jar.004",
      "lang": "zh",
      "registers": ["zh-forum", "zh-academic"],
      "category": "jargon",
      "pattern": "(?:全方位|立体化|多层次|多维度|系统性|全链条|全要素)",
      "severity": "low",
      "action": "review",
      "strategy": "jargon",
      "message": "万能程度词，信息量为零。",
      "fix_hint": "换成具体范围或数量（“覆盖 8 个区县、32 所学校”）。"
    },
    {
      "id": "zh.jar.005",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "深度融合",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "融合",
      "message": "“深度融合”是抬价式搭配。",
      "fix_hint": "写清融合在哪个环节（课程/教研/评价）。"
    },
    {
      "id": "zh.jar.006",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "(?:织密|织牢|擦亮|盘活|撬动|激活|点燃)",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "宣传腔动词。",
      "fix_hint": "换成普通动词并补出对象与结果。"
    },
    {
      "id": "zh.jar.007",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "(?:提质增效|提档升级|迭代升级|提质升级|增强动能)",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "四字口号式搭配。",
      "fix_hint": "拆成“做什么 + 提升什么指标”。"
    },
    {
      "id": "zh.jar.008",
      "lang": "zh",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "(?:新动能|新引擎|新活力|新篇章|新征程|新答卷|新画卷)",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "宣传腔名词。",
      "fix_hint": "换成具体目标或产物。"
    },
    {
      "id": "zh.nom.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "nominalization",
      "pattern": "具有一定的(参考|学术|实践|借鉴|推广)(价值|意义)",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "nominal",
      "replacement": "有\\1\\2",
      "message": "名词化虚化表达。",
      "fix_hint": "直接写“有参考价值”，或更实：写清对谁、在哪方面有用。"
    },
    {
      "id": "zh.nom.002",
      "lang": "zh",
      "registers": ["all"],
      "category": "nominalization",
      "pattern": "具有统计学意义",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "nominal",
      "replacement": "差异在统计上显著",
      "message": "名词化表达。",
      "fix_hint": "直接写“差异显著”，并给出统计量。"
    },
    {
      "id": "zh.nom.003",
      "lang": "zh",
      "registers": ["all"],
      "category": "nominalization",
      "pattern": "实现从(.{2,24}?)向(.{2,24}?)的转变",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "nominal",
      "replacement": "由\\1转向\\2",
      "message": "名词化句式“实现从A向B的转变”。",
      "fix_hint": "还原成动词“由A转向B”。"
    },
    {
      "id": "zh.nom.004",
      "lang": "zh",
      "registers": ["all"],
      "category": "nominalization",
      "pattern": "实现(.{2,24}?)的(?:转变|转型)",
      "severity": "low",
      "action": "review",
      "strategy": "nominal",
      "message": "名词化句式“实现…的转变”。",
      "fix_hint": "还原成动词，如“转向…”。"
    },
    {
      "id": "zh.nom.005",
      "lang": "zh",
      "registers": ["zh-forum", "zh-academic"],
      "category": "nominalization",
      "pattern": "(?:进行|开展|实施)(分析|研究|梳理|比较|评估|检验|统计|调查|访谈|观察|编码|测评)",
      "severity": "low",
      "action": "review",
      "strategy": "nominal",
      "message": "“进行+名词”是纸面化写法。",
      "fix_hint": "直接用动词：“进行分析”→“分析”，并把宾语提到动词后。"
    },
    {
      "id": "zh.par.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "parallelism",
      "pattern": "(?:^|[，。；])([\\u4e00-\\u9fff]{2})[^，。；]{2,18}[，；]\\1[^，。；]{2,18}[，；]\\1",
      "severity": "medium",
      "action": "review",
      "strategy": "parallel_triplet",
      "message": "三项以上同构排比（同一领起词连用三次）。",
      "fix_hint": "留两项，第三项换说法或删掉；排比是模型的克制服。"
    },
    {
      "id": "zh.lyr.001",
      "lang": "zh",
      "registers": ["all"],
      "category": "abstract_lyric",
      "pattern": "(?:彰显|折射|凝练|昭示|勾勒)(?:出|了)?[^。；]{0,20}(?:价值|意义|力量|气象|底色)",
      "severity": "medium",
      "action": "review",
      "strategy": "lyric",
      "message": "抽象抒情：给事实硬贴价值。",
      "fix_hint": "删掉抒情，把支撑它的数据或事实摆出来。"
    },
    {
      "id": "zh.lyr.002",
      "lang": "zh",
      "registers": ["all"],
      "category": "abstract_lyric",
      "pattern": "(?:注入|赋予)(?:了)?[^。；]{0,12}(?:新动能|新活力|新势能|灵魂|生命力)",
      "severity": "medium",
      "action": "review",
      "strategy": "lyric",
      "message": "抽象升华搭配。",
      "fix_hint": "换成可核查的结果（提升了多少、改变了什么行为）。"
    },
    {
      "id": "zh.lyr.003",
      "lang": "zh",
      "registers": ["all"],
      "category": "abstract_lyric",
      "pattern": "(?:既是|也是)[^。；]{0,20}(?:更是)[^。；]{0,20}",
      "severity": "medium",
      "action": "review",
      "strategy": "lyric",
      "message": "递进式抒情模板（“既是…也是…更是…”）。",
      "fix_hint": "只保留最重要的一项判断。"
    },
    {
      "id": "zh.pun.001",
      "lang": "zh",
      "registers": ["zh-forum"],
      "category": "punctuation",
      "pattern": "——",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "punct",
      "replacement": "，",
      "message": "修辞破折号。",
      "fix_hint": "改成逗号或句号；年段、链式表述与标准号中的连接号“—”属国标本义，不在此列。"
    },
    {
      "id": "zh.pun.002",
      "lang": "zh",
      "registers": ["zh-forum", "zh-academic"],
      "category": "punctuation",
      "pattern": "(?:其?核心是|本质上是|关键是|一句话概括)：",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "punct",
      "replacement": "核心在于",
      "message": "提示性冒号（后接非人物原话）。",
      "fix_hint": "改成动词结构（“核心在于…”），或把冒号后内容写成完整句。"
    },
    {
      "id": "zh.fil.001",
      "lang": "zh",
      "registers": ["zh-forum"],
      "category": "filler",
      "pattern": "(?:^|[。；])(?:实际上|事实上|毫无疑问|不可否认)[，、,]?",
      "severity": "low",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "空转副词。",
      "fix_hint": "删掉后句子照样成立就删。"
    },
    {
      "id": "zh.fil.002",
      "lang": "zh",
      "registers": ["zh-forum", "zh-academic"],
      "category": "filler",
      "pattern": "(?:尤为|至关|非常|十分|极其)(?:重要|关键|显著)",
      "severity": "low",
      "action": "review",
      "strategy": "filler",
      "message": "程度词抬价。",
      "fix_hint": "用数字或事实替代程度词。"
    },
    {
      "id": "zh.fil.003",
      "lang": "zh",
      "registers": ["all"],
      "category": "filler",
      "pattern": "(?:在当今|随着社会的不断发展|当今社会|新时代背景下|在信息化时代)",
      "severity": "low",
      "action": "review",
      "strategy": "filler",
      "message": "万能开头背景句。",
      "fix_hint": "换成有具体时间、地点、政策文号的背景。"
    }
  ]
}
