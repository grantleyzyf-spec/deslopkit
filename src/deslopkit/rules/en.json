{
  "version": "0.1.0",
  "lang": "en",
  "note": "English rule set. Pattern catalog is aligned with the widely used 'signs of AI writing' community lists (Wikipedia WikiProject AI Cleanup, blader/humanizer, DeSlop), re-expressed as machine-checkable regex with an explicit fidelity gate.",
  "rules": [
    {
      "id": "en.neg.001",
      "lang": "en",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "\\b(is|are|was|were|it'?s|this is)\\s+not\\s+(?:just|merely|only|simply)\\s+([^,;.]{2,60})[,;]\\s*(?:but|it'?s|this is)\\s+([^.!?]{2,80})",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\1 \\3, not just \\2",
      "message": "Negation pivot: sets up a claim the reader never made, then overturns it.",
      "fix_hint": "State the affirmative claim first and demote the contrast to a trailing qualifier."
    },
    {
      "id": "en.neg.001b",
      "lang": "en",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "\\b(is|are|was|were|it'?s|this is)\\s+not\\s+(?!just\\b)(?:about\\s+)?([^,;.]{2,60})[,;]\\s*(?:but|it'?s|this is)\\s+([^.!?]{2,80})",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\1 \\3, not \\2",
      "message": "Negation pivot variant without an intensifier.",
      "fix_hint": "Give the real claim first."
    },
    {
      "id": "en.neg.002",
      "lang": "en",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "\\bnot\\s+because\\s+([^,;.]{2,60})[,;]\\s*but\\s+because\\s+([^.!?]{2,80})",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "neg_pivot",
      "replacement": "\\2",
      "message": "Negation pivot variant.",
      "fix_hint": "Give the real cause first."
    },
    {
      "id": "en.neg.003",
      "lang": "en",
      "registers": ["all"],
      "category": "negation_pivot",
      "pattern": "\\b(?:more|less)\\s+than\\s+(?:just|merely)\\b[^.!?]{0,60}[,;]\\s*(?:it'?s|they'?re)\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "neg_pivot",
      "message": "'More than just X, it's Y' escalation frame.",
      "fix_hint": "Replace with the concrete claim."
    },
    {
      "id": "en.cli.001",
      "lang": "en",
      "registers": ["all"],
      "category": "english_cliche",
      "pattern": "\\bIn today'?s\\s+(?:fast[- ]paced|ever[- ]changing|modern|digital|competitive)\\s+(?:world|landscape|environment|era)\\b",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "Boilerplate opener.",
      "fix_hint": "Open with the actual subject, date, or finding."
    },
    {
      "id": "en.cli.002",
      "lang": "en",
      "registers": ["all"],
      "category": "english_cliche",
      "pattern": "\\bIt'?s\\s+(?:worth|important|critical)\\s+(?:noting|to note)\\s+that\\b",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "Faux-significance signpost.",
      "fix_hint": "Delete it; the following clause stands on its own."
    },
    {
      "id": "en.cli.003",
      "lang": "en",
      "registers": ["all"],
      "category": "english_cliche",
      "pattern": "\\bIt\\s+is\\s+(?:crucial|essential|vital|imperative)\\s+to\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "delete",
      "message": "Empty强调 frame.",
      "fix_hint": "State who should do what, or drop the frame."
    },
    {
      "id": "en.cli.004",
      "lang": "en",
      "registers": ["all"],
      "category": "signposting",
      "pattern": "\\b(?:In conclusion|To sum up|All in all|In summary)\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "signpost",
      "message": "Summary signpost.",
      "fix_hint": "In academic sections keep it only where required; in prose, end on the last concrete thing."
    },
    {
      "id": "en.cli.005",
      "lang": "en",
      "registers": ["all"],
      "category": "signposting",
      "pattern": "\\b(?:Furthermore|Moreover|Additionally|In addition)\\b",
      "flags": "i",
      "severity": "low",
      "action": "review",
      "strategy": "signpost",
      "message": "Additive connective — a tell when chained three or more times.",
      "fix_hint": "Vary or delete; let the content show the relation."
    },
    {
      "id": "en.cli.006",
      "lang": "en",
      "registers": ["en-essay"],
      "category": "english_cliche",
      "pattern": "\\bLet'?s\\s+(?:dive in|explore|take a look|unpack)\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "Let us examine",
      "message": "Chatty约定式 opener.",
      "fix_hint": "Start with the topic itself."
    },
    {
      "id": "en.jar.001",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\b(?:delve|dives?|diving)\\s+into\\b",
      "flags": "i",
      "severity": "high",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "examine",
      "message": "'Delve into' — the canonical LLM verb.",
      "fix_hint": "Use examine, look at, study."
    },
    {
      "id": "en.jar.002",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\b(?:tapestry|testament to|realm of|cornerstone of|pillar of|game[- ]?changer|double[- ]edged sword)\\b",
      "flags": "i",
      "severity": "high",
      "action": "review",
      "strategy": "jargon",
      "message": "Metaphor filler borrowed for abstraction.",
      "fix_hint": "Say the concrete thing the metaphor replaced."
    },
    {
      "id": "en.jar.003",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\bleverage(?:s|d|ing)?\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "use",
      "message": "Corporate jargon.",
      "fix_hint": "Use 'use' or name the mechanism."
    },
    {
      "id": "en.jar.004",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\butili[sz]e(?:s|d|ing)?\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "use",
      "message": "Inflated verb.",
      "fix_hint": "Use 'use'."
    },
    {
      "id": "en.jar.005",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\b(?:navigate|unpack|unlock|harness)\\s+the\\s+(?:complexit\\w+|nuance\\w*|landscape|potential|power)\\b",
      "flags": "i",
      "severity": "high",
      "action": "review",
      "strategy": "jargon",
      "message": "Formulaic verb phrase.",
      "fix_hint": "Name the specific difficulty or capability."
    },
    {
      "id": "en.jar.006",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\b(?:a\\s+)?(?:myriad|plethora|multitude|wealth)\\s+of\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "many",
      "message": "Padded quantifier.",
      "fix_hint": "Use a number or 'many'."
    },
    {
      "id": "en.jar.007",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\b(?:serve[sd]?|stand[s]?)\\s+as\\s+a\\s+(?:testament|reminder|symbol)\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "Symbolic framing.",
      "fix_hint": "State what it shows and for whom."
    },
    {
      "id": "en.jar.008",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\bunderscor(?:e|es|ed|ing)\\s+the\\s+(?:importance|significance|need|value)\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "Empty emphasis clause.",
      "fix_hint": "Give the evidence instead."
    },
    {
      "id": "en.jar.009",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\bplay(?:s|ed|ing)?\\s+a\\s+(?:crucial|pivotal|vital|key|significant)\\s+role\\b",
      "flags": "i",
      "severity": "medium",
      "action": "review",
      "strategy": "jargon",
      "message": "Vague causal claim.",
      "fix_hint": "Say what it does and how much it accounts for."
    },
    {
      "id": "en.jar.010",
      "lang": "en",
      "registers": ["all"],
      "category": "jargon",
      "pattern": "\\bwhen it comes to\\b",
      "flags": "i",
      "severity": "low",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "in",
      "message": "Filler phrase.",
      "fix_hint": "Rewrite with a direct preposition."
    },
    {
      "id": "en.cli.007",
      "lang": "en",
      "registers": ["all"],
      "category": "english_cliche",
      "pattern": "\\bIn the (?:realm|world|landscape) of\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "replace",
      "replacement": "In",
      "message": "Ornamental prepositional phrase.",
      "fix_hint": "'In' is enough."
    },
    {
      "id": "en.cli.008",
      "lang": "en",
      "registers": ["all"],
      "category": "english_cliche",
      "pattern": "\\b(?:very|really|truly|quite|highly)\\s+(?:important|significant|impactful|powerful|robust)\\b",
      "flags": "i",
      "severity": "low",
      "action": "review",
      "strategy": "filler",
      "message": "Intensifier without evidence.",
      "fix_hint": "Quantify."
    },
    {
      "id": "en.fil.001",
      "lang": "en",
      "registers": ["all"],
      "category": "filler",
      "pattern": "\\bIt goes without saying that\\b|\\bneedless to say\\b|\\bas we all know\\b",
      "flags": "i",
      "severity": "medium",
      "action": "rewrite",
      "strategy": "delete",
      "replacement": "",
      "message": "Empty preamble.",
      "fix_hint": "Delete."
    },
    {
      "id": "en.fil.002",
      "lang": "en",
      "registers": ["all"],
      "category": "filler",
      "pattern": "\\b(?:Overall|Broadly speaking|Generally speaking|By and large),\\s",
      "flags": "i",
      "severity": "low",
      "action": "review",
      "strategy": "signpost",
      "message": "Hedging opener.",
      "fix_hint": "Use it once at most, and only where the generalisation is real."
    },
    {
      "id": "en.par.001",
      "lang": "en",
      "registers": ["all"],
      "category": "parallelism",
      "pattern": "\\b(\\w{3,})\\b[^.!?]{0,30},\\s*\\b(\\w{3,})\\b[^.!?]{0,30},\\s*and\\s+\\b(\\w{3,})\\b[^.!?]{0,20}",
      "flags": "i",
      "severity": "low",
      "action": "review",
      "strategy": "parallel_triplet",
      "message": "Possible triadic list (rule of three).",
      "fix_hint": "Keep two items, or replace the third with a different construction."
    },
    {
      "id": "en.pun.001",
      "lang": "en",
      "registers": ["all"],
      "category": "punctuation",
      "pattern": "\\s—\\s",
      "severity": "low",
      "action": "review",
      "strategy": "punct",
      "message": "Spaced em dash.",
      "fix_hint": "Use a comma, colon, or parentheses; keep em dashes under about one per 300 words."
    }
  ]
}
